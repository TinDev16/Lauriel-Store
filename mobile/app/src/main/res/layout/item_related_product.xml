<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
 xmlns:app="http://schemas.android.com/apk/res-auto" style="@style/Card.Lauriel"
 android:layout_width="164dp" android:layout_height="wrap_content" android:layout_marginEnd="@dimen/space_sm"
 android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
  <FrameLayout android:layout_width="match_parent" android:layout_height="180dp">
   <ImageView android:id="@+id/image" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" android:src="@drawable/image_placeholder" android:contentDescription="@string/product_image"/>
   <TextView android:id="@+id/promotion" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="top|end" android:layout_margin="@dimen/space_sm" android:background="@drawable/bg_sale_badge" android:paddingHorizontal="@dimen/space_sm" android:paddingVertical="@dimen/space_xxs" android:textColor="@color/on_accent" android:textSize="11sp" android:textStyle="bold" android:visibility="gone"/>
  </FrameLayout>
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/space_sm">
   <TextView android:id="@+id/name" android:layout_width="match_parent" android:layout_height="40dp" android:maxLines="2" android:ellipsize="end" android:textAppearance="@style/TextAppearance.Lauriel.Product"/>
   <TextView android:id="@+id/effective_price" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_xxs" android:textAppearance="@style/TextAppearance.Lauriel.Price" android:textColor="@color/danger"/>
   <TextView android:id="@+id/price" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.Lauriel.Caption" android:visibility="gone"/>
  </LinearLayout>
 </LinearLayout>
</com.google.android.material.card.MaterialCardView>
