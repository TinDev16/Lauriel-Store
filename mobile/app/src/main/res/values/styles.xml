<resources>
    <style name="Theme.Lauriel" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/ink</item><item name="colorPrimaryVariant">@color/ink</item><item name="colorOnPrimary">@color/on_accent</item>
        <item name="colorSecondary">@color/ink</item><item name="colorSurface">@color/background</item><item name="colorOnSurface">@color/ink</item><item name="colorError">@color/danger</item>
        <item name="android:fontFamily">sans</item><item name="android:navigationBarColor">@color/background</item>
        <item name="android:statusBarColor">@color/background</item><item name="android:windowLightStatusBar">true</item><item name="android:windowBackground">@color/background</item>
        <item name="android:windowActivityTransitions">true</item><item name="android:windowEnterAnimation">@anim/fade_in</item><item name="android:windowExitAnimation">@anim/fade_out</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.Lauriel.Dialog</item>
    </style>
    <style name="ThemeOverlay.Lauriel.Dialog" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog"><item name="shapeAppearanceMediumComponent">@style/Shape.Lauriel.Large</item></style>
    <style name="Shape.Lauriel.Large" parent="ShapeAppearance.MaterialComponents.LargeComponent"><item name="cornerFamily">rounded</item><item name="cornerSize">@dimen/radius_lg</item></style>
    <style name="PrimaryButton" parent="Widget.MaterialComponents.Button"><item name="backgroundTint">@color/ink</item><item name="android:textColor">@color/on_accent</item><item name="cornerRadius">@dimen/radius_md</item><item name="android:textAllCaps">false</item><item name="android:textStyle">bold</item><item name="android:minHeight">52dp</item></style>
    <style name="SecondaryButton" parent="Widget.MaterialComponents.Button.OutlinedButton"><item name="strokeColor">@color/divider</item><item name="android:textColor">@color/ink</item><item name="cornerRadius">@dimen/radius_md</item><item name="android:textAllCaps">false</item><item name="android:minHeight">48dp</item></style>
    <style name="TextButton" parent="Widget.MaterialComponents.Button.TextButton"><item name="android:textColor">@color/ink</item><item name="android:textAllCaps">false</item><item name="android:minHeight">48dp</item></style>
    <style name="BackButton" parent="Widget.MaterialComponents.Button.TextButton.Icon">
        <item name="android:layout_width">@dimen/touch_min</item>
        <item name="android:layout_height">@dimen/touch_min</item>
        <item name="android:minWidth">@dimen/touch_min</item>
        <item name="android:minHeight">@dimen/touch_min</item>
        <item name="icon">@drawable/ic_back</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">0dp</item>
        <item name="iconTint">@color/ink</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>
    <style name="DestructiveButton" parent="Widget.MaterialComponents.Button.OutlinedButton"><item name="strokeColor">@color/danger</item><item name="android:textColor">@color/danger</item><item name="cornerRadius">@dimen/radius_md</item><item name="android:textAllCaps">false</item><item name="android:minHeight">48dp</item></style>
    <style name="InputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox"><item name="boxCornerRadiusTopStart">@dimen/radius_md</item><item name="boxCornerRadiusTopEnd">@dimen/radius_md</item><item name="boxCornerRadiusBottomStart">@dimen/radius_md</item><item name="boxCornerRadiusBottomEnd">@dimen/radius_md</item><item name="boxStrokeColor">@color/muted</item><item name="hintTextColor">@color/muted</item></style>
    <style name="Card.Lauriel" parent="Widget.MaterialComponents.CardView"><item name="cardBackgroundColor">@color/surface</item><item name="cardCornerRadius">@dimen/radius_lg</item><item name="cardElevation">0dp</item><item name="strokeColor">@color/divider</item><item name="strokeWidth">1dp</item></style>
    <style name="TextAppearance.Lauriel.LargeTitle" parent="TextAppearance.MaterialComponents.Headline4"><item name="android:textColor">@color/ink</item><item name="android:textSize">28sp</item><item name="android:textStyle">bold</item></style>
    <style name="TextAppearance.Lauriel.ScreenTitle" parent="TextAppearance.MaterialComponents.Headline5"><item name="android:textColor">@color/ink</item><item name="android:textSize">24sp</item><item name="android:textStyle">bold</item></style>
    <style name="TextAppearance.Lauriel.SectionTitle" parent="TextAppearance.MaterialComponents.Headline6"><item name="android:textColor">@color/ink</item><item name="android:textSize">19sp</item><item name="android:textStyle">bold</item></style>
    <style name="TextAppearance.Lauriel.Product" parent="TextAppearance.MaterialComponents.Body1"><item name="android:textColor">@color/ink</item><item name="android:textSize">16sp</item><item name="android:textStyle">bold</item></style>
    <style name="TextAppearance.Lauriel.Price" parent="TextAppearance.MaterialComponents.Subtitle1"><item name="android:textColor">@color/ink</item><item name="android:textSize">17sp</item><item name="android:textStyle">bold</item></style>
    <style name="TextAppearance.Lauriel.Body" parent="TextAppearance.MaterialComponents.Body1"><item name="android:textColor">@color/ink</item><item name="android:textSize">15sp</item></style>
    <style name="TextAppearance.Lauriel.Caption" parent="TextAppearance.MaterialComponents.Caption"><item name="android:textColor">@color/muted</item><item name="android:textSize">13sp</item></style>
    <style name="TextAppearance.Lauriel.Navigation" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">11sp</item>
        <item name="android:lineSpacingExtra">0dp</item>
    </style>
    <style name="NavActiveIndicator"><item name="android:color">@color/surface_strong</item><item name="shapeAppearance">@style/Shape.Lauriel.Large</item></style>
</resources>
