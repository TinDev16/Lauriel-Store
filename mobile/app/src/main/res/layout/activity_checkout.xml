<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:paddingHorizontal="@dimen/space_12" android:paddingTop="@dimen/space_sm"><com.google.android.material.button.MaterialButton android:id="@+id/back" style="@style/Widget.MaterialComponents.Button.TextButton.Icon" android:layout_width="48dp" android:layout_height="48dp" android:contentDescription="@string/back" app:icon="@drawable/ic_back" app:iconGravity="textStart" app:iconPadding="0dp"/><TextView android:id="@+id/title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/checkout_title" android:textAppearance="@style/TextAppearance.Lauriel.ScreenTitle"/></LinearLayout>
  <androidx.core.widget.NestedScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="@dimen/screen_padding" android:paddingBottom="@dimen/space_xl">
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_md" android:text="@string/delivery_address" android:textAppearance="@style/TextAppearance.Lauriel.SectionTitle"/>
      <com.google.android.material.card.MaterialCardView style="@style/Card.Lauriel" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_12"><com.google.android.material.textfield.TextInputLayout android:id="@+id/address_layout" style="@style/InputLayout" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_margin="@dimen/space_12" android:hint="@string/shipping_address"><com.google.android.material.textfield.TextInputEditText android:id="@+id/address" android:layout_width="match_parent" android:layout_height="wrap_content" android:imeOptions="actionNext" android:inputType="textPostalAddress" android:maxLines="2"/></com.google.android.material.textfield.TextInputLayout></com.google.android.material.card.MaterialCardView>
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_20" android:text="@string/products_label" android:textAppearance="@style/TextAppearance.Lauriel.SectionTitle"/>
      <com.google.android.material.card.MaterialCardView style="@style/Card.Lauriel" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_12"><TextView android:id="@+id/summary" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="@dimen/space_md" android:textAppearance="@style/TextAppearance.Lauriel.Body" android:lineSpacingExtra="4dp"/></com.google.android.material.card.MaterialCardView>
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_20" android:text="@string/voucher_code" android:textAppearance="@style/TextAppearance.Lauriel.SectionTitle"/>
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_12" android:gravity="center_vertical"><com.google.android.material.textfield.TextInputLayout android:id="@+id/voucher_layout" style="@style/InputLayout" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:hint="@string/voucher_code" app:endIconMode="clear_text"><com.google.android.material.textfield.TextInputEditText android:id="@+id/voucher" android:layout_width="match_parent" android:layout_height="wrap_content" android:imeOptions="actionDone" android:inputType="textCapCharacters" android:maxLines="1"/></com.google.android.material.textfield.TextInputLayout><com.google.android.material.button.MaterialButton android:id="@+id/apply" style="@style/SecondaryButton" android:layout_width="wrap_content" android:layout_height="56dp" android:layout_marginStart="@dimen/space_sm" android:text="@string/apply"/></LinearLayout>
      <com.google.android.material.card.MaterialCardView android:id="@+id/preview_card" style="@style/Card.Lauriel" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_12" android:visibility="gone" app:cardBackgroundColor="@color/success_surface" app:strokeColor="@color/success"><TextView android:id="@+id/preview" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="@dimen/space_md" android:textAppearance="@style/TextAppearance.Lauriel.Body" android:textColor="@color/success"/></com.google.android.material.card.MaterialCardView>
      <TextView android:id="@+id/note" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_12" android:text="@string/final_price_note" android:textAppearance="@style/TextAppearance.Lauriel.Caption"/>
      <com.google.android.material.progressindicator.CircularProgressIndicator android:id="@+id/loading" android:layout_width="32dp" android:layout_height="32dp" android:layout_gravity="center" android:layout_marginTop="@dimen/space_md" android:visibility="gone" app:indicatorColor="@color/ink" app:trackThickness="3dp"/>
      <TextView android:id="@+id/error" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_sm" android:accessibilityLiveRegion="polite" android:textColor="@color/danger" android:textSize="14sp"/>
    </LinearLayout>
  </androidx.core.widget.NestedScrollView>
  <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider"/>
  <com.google.android.material.button.MaterialButton android:id="@+id/checkout" style="@style/PrimaryButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="@dimen/screen_padding" android:layout_marginVertical="@dimen/space_12" android:text="@string/checkout"/>
</LinearLayout>