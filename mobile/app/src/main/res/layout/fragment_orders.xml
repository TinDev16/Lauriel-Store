<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:paddingHorizontal="@dimen/screen_padding">
  <TextView android:id="@+id/title" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="@dimen/space_md" android:paddingBottom="@dimen/space_12" android:text="@string/orders" android:textAppearance="@style/TextAppearance.Lauriel.ScreenTitle"/>
  <com.google.android.material.progressindicator.CircularProgressIndicator android:id="@+id/loading" android:layout_width="32dp" android:layout_height="32dp" android:layout_gravity="center" android:visibility="gone" app:indicatorColor="@color/ink" app:trackThickness="3dp"/>
  <ImageView android:id="@+id/state_icon" android:contentDescription="@null" android:layout_width="64dp" android:layout_height="64dp" android:layout_gravity="center" android:layout_marginTop="@dimen/space_xl" android:src="@drawable/ic_nav_orders" android:visibility="gone"/>
  <TextView android:id="@+id/empty" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:padding="@dimen/space_12" android:text="@string/empty_orders" android:textAppearance="@style/TextAppearance.Lauriel.SectionTitle" android:visibility="gone"/>
  <TextView android:id="@+id/error" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:padding="@dimen/space_sm" android:textColor="@color/danger" android:textSize="14sp"/>
  <androidx.recyclerview.widget.RecyclerView android:id="@+id/list" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:clipToPadding="false" android:paddingBottom="@dimen/space_md"/>
  <com.google.android.material.button.MaterialButton android:id="@+id/load_more" style="@style/SecondaryButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/space_sm" android:text="@string/load_more"/>
</LinearLayout>