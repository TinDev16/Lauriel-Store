<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" style="@style/Card.Lauriel" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/space_12">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:padding="@dimen/space_12">
    <ImageView android:id="@+id/image" android:layout_width="96dp" android:layout_height="120dp" android:contentDescription="@string/product_image" android:scaleType="centerCrop" android:src="@drawable/image_placeholder"/>
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="@dimen/space_12" android:layout_weight="1" android:orientation="vertical">
      <TextView android:id="@+id/name" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="2" android:textAppearance="@style/TextAppearance.Lauriel.Product"/>
      <TextView android:id="@+id/options" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_xxs" android:textAppearance="@style/TextAppearance.Lauriel.Caption"/>
      <TextView android:id="@+id/price" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_sm" android:textAppearance="@style/TextAppearance.Lauriel.Price"/>
      <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="@dimen/space_sm" android:gravity="center_vertical" android:orientation="horizontal">
        <com.google.android.material.button.MaterialButton android:id="@+id/decrease" style="@style/SecondaryButton" android:layout_width="48dp" android:layout_height="48dp" android:contentDescription="@string/decrease_quantity" android:minWidth="0dp" android:padding="0dp" android:text="@string/minus"/>
        <TextView android:id="@+id/quantity" android:layout_width="40dp" android:layout_height="48dp" android:gravity="center" android:textAppearance="@style/TextAppearance.Lauriel.Product"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/increase" style="@style/SecondaryButton" android:layout_width="48dp" android:layout_height="48dp" android:contentDescription="@string/increase_quantity" android:minWidth="0dp" android:padding="0dp" android:text="@string/plus"/>
        <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/remove" style="@style/TextButton" android:layout_width="48dp" android:layout_height="48dp" android:contentDescription="@string/remove" android:minWidth="0dp" android:padding="0dp" app:icon="@drawable/ic_delete" app:iconGravity="textStart" app:iconPadding="0dp" app:iconTint="@color/danger"/>
      </LinearLayout>
    </LinearLayout>
  </LinearLayout>
</com.google.android.material.card.MaterialCardView>