<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:paddingHorizontal="@dimen/screen_padding">
  <TextView android:id="@+id/title" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="@dimen/space_md" android:paddingBottom="@dimen/space_12" android:text="@string/cart" android:textAppearance="@style/TextAppearance.Lauriel.ScreenTitle"/>
  <com.google.android.material.progressindicator.CircularProgressIndicator android:id="@+id/loading" android:layout_width="32dp" android:layout_height="32dp" android:layout_gravity="center" android:visibility="gone" app:indicatorColor="@color/ink" app:trackThickness="3dp"/>
  <TextView android:id="@+id/error" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:textColor="@color/danger" android:textSize="14sp"/>
  <LinearLayout android:id="@+id/empty_container" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:padding="@dimen/space_lg" android:visibility="gone">
    <ImageView android:layout_width="72dp" android:layout_height="72dp" android:contentDescription="@string/empty_cart" android:src="@drawable/ic_empty_bag"/>
    <TextView android:id="@+id/empty" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_md" android:gravity="center" android:text="@string/empty_cart" android:textAppearance="@style/TextAppearance.Lauriel.SectionTitle"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_sm" android:gravity="center" android:text="@string/empty_cart_hint" android:textAppearance="@style/TextAppearance.Lauriel.Caption"/>
    <com.google.android.material.button.MaterialButton android:id="@+id/continue_shopping" style="@style/PrimaryButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_lg" android:text="@string/continue_shopping"/>
  </LinearLayout>
  <androidx.recyclerview.widget.RecyclerView android:id="@+id/list" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:clipToPadding="false" android:paddingBottom="@dimen/space_md"/>
  <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider"/>
  <TextView android:id="@+id/subtotal" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_12" android:gravity="end" android:textAppearance="@style/TextAppearance.Lauriel.Price"/>
  <TextView android:id="@+id/note" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="end" android:text="@string/final_price_note" android:textAppearance="@style/TextAppearance.Lauriel.Caption"/>
  <com.google.android.material.button.MaterialButton android:id="@+id/checkout" style="@style/PrimaryButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_12" android:layout_marginBottom="@dimen/space_12" android:text="@string/proceed_checkout"/>
</LinearLayout>