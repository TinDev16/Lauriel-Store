<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
 android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
 android:paddingHorizontal="@dimen/screen_padding" android:paddingTop="@dimen/space_md" android:paddingBottom="@dimen/space_xl">
 <View android:layout_width="42dp" android:layout_height="4dp" android:layout_gravity="center" android:background="@color/divider"/>
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_md" android:orientation="horizontal">
  <ImageView android:id="@+id/image" android:layout_width="96dp" android:layout_height="112dp" android:scaleType="centerCrop" android:src="@drawable/image_placeholder" android:contentDescription="@string/product_image"/>
  <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="@dimen/space_12" android:orientation="vertical">
   <TextView android:id="@+id/name" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.Lauriel.SectionTitle"/>
   <TextView android:id="@+id/price" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_sm" android:textAppearance="@style/TextAppearance.Lauriel.Price"/>
   <TextView android:id="@+id/stock" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_xxs" android:textAppearance="@style/TextAppearance.Lauriel.Caption"/>
  </LinearLayout>
 </LinearLayout>
 <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_md" android:text="@string/size_label" android:textAppearance="@style/TextAppearance.Lauriel.SectionTitle"/>
 <com.google.android.material.chip.ChipGroup android:id="@+id/sizes" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_sm" app:singleSelection="true" app:selectionRequired="false"/>
 <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_md" android:text="@string/color_label" android:textAppearance="@style/TextAppearance.Lauriel.SectionTitle"/>
 <com.google.android.material.chip.ChipGroup android:id="@+id/colors" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_sm" app:singleSelection="true" app:selectionRequired="false"/>
 <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_md" android:text="@string/quantity_label" android:textAppearance="@style/TextAppearance.Lauriel.SectionTitle"/>
 <LinearLayout android:layout_width="wrap_content" android:layout_height="48dp" android:layout_marginTop="@dimen/space_sm" android:gravity="center">
  <com.google.android.material.button.MaterialButton android:id="@+id/decrease" style="@style/TextButton" android:layout_width="48dp" android:layout_height="48dp" android:text="@string/minus"/>
  <TextView android:id="@+id/quantity" android:layout_width="48dp" android:layout_height="48dp" android:gravity="center" android:text="@string/one" android:textAppearance="@style/TextAppearance.Lauriel.Product"/>
  <com.google.android.material.button.MaterialButton android:id="@+id/increase" style="@style/TextButton" android:layout_width="48dp" android:layout_height="48dp" android:text="@string/plus"/>
 </LinearLayout>
 <com.google.android.material.button.MaterialButton android:id="@+id/confirm" style="@style/PrimaryButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_md" android:text="Xác nhận"/>
</LinearLayout>
