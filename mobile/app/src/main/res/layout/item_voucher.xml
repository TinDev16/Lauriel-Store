<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
 xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/card" style="@style/Card.Lauriel"
 android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/space_12">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
  <LinearLayout android:layout_width="88dp" android:layout_height="match_parent" android:minHeight="166dp"
   android:background="@color/ink" android:gravity="center" android:orientation="vertical" android:padding="@dimen/space_sm">
   <ImageView android:layout_width="32dp" android:layout_height="32dp" android:src="@drawable/ic_ticket"
    android:contentDescription="@null" app:tint="@color/on_accent"/>
   <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_sm"
    android:text="LAURIEL" android:textColor="@color/on_accent" android:textSize="11sp" android:textStyle="bold"/>
  </LinearLayout>
  <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
   android:orientation="vertical" android:padding="@dimen/space_md">
   <TextView android:id="@+id/saved_badge" android:layout_width="wrap_content" android:layout_height="wrap_content"
    android:background="@drawable/bg_saved_badge" android:paddingHorizontal="@dimen/space_sm"
    android:paddingVertical="@dimen/space_xxs" android:text="✓ ĐÃ LƯU"
    android:textColor="@color/success" android:textSize="11sp" android:textStyle="bold" android:visibility="gone"/>
   <TextView android:id="@+id/name" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/space_xxs" android:textAppearance="@style/TextAppearance.Lauriel.Product"/>
   <TextView android:id="@+id/discount" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/space_xxs" android:textColor="@color/success" android:textStyle="bold"/>
   <TextView android:id="@+id/condition" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/space_xxs" android:textAppearance="@style/TextAppearance.Lauriel.Caption"/>
   <TextView android:id="@+id/expiry" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/space_xxs" android:textAppearance="@style/TextAppearance.Lauriel.Caption"/>
   <TextView android:id="@+id/code" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/space_sm" android:fontFamily="monospace"
    android:textColor="@color/ink" android:textStyle="bold"/>
   <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/space_sm" android:gravity="end">
    <com.google.android.material.button.MaterialButton android:id="@+id/copy" style="@style/TextButton"
     android:layout_width="wrap_content" android:layout_height="40dp" android:text="@string/copy_voucher"/>
    <com.google.android.material.button.MaterialButton android:id="@+id/save" style="@style/TextButton"
     android:layout_width="wrap_content" android:layout_height="40dp" android:text="Lưu mã" app:icon="@drawable/ic_bookmark"
     app:iconGravity="textStart" app:iconTint="@color/ink"/>
   </LinearLayout>
  </LinearLayout>
 </LinearLayout>
</com.google.android.material.card.MaterialCardView>
