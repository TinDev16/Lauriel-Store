<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical" android:padding="@dimen/space_lg">
  <TextView android:id="@+id/brand" android:layout_width="wrap_content" android:layout_height="wrap_content" android:letterSpacing="0.2" android:text="@string/brand" android:textAppearance="@style/TextAppearance.Lauriel.LargeTitle" android:textSize="34sp"/>
  <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_lg" android:gravity="center" android:text="@string/checking_session" android:textAppearance="@style/TextAppearance.Lauriel.Body" android:textColor="@color/muted"/>
  <com.google.android.material.progressindicator.CircularProgressIndicator android:id="@+id/loading" android:layout_width="36dp" android:layout_height="36dp" android:layout_marginTop="@dimen/space_lg" app:indicatorColor="@color/ink" app:trackThickness="3dp"/>
  <com.google.android.material.button.MaterialButton android:id="@+id/retry" style="@style/PrimaryButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_lg" android:text="@string/retry" android:visibility="gone"/>
</LinearLayout>