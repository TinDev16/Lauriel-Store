<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:paddingHorizontal="@dimen/screen_padding">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:paddingTop="@dimen/space_12" android:paddingBottom="@dimen/space_12">
    <TextView android:id="@+id/title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:letterSpacing="0.14" android:text="@string/brand" android:textAppearance="@style/TextAppearance.Lauriel.ScreenTitle"/>
    <com.google.android.material.button.MaterialButton android:id="@+id/categories_toggle" style="@style/Widget.MaterialComponents.Button.TextButton.Icon" android:layout_width="48dp" android:layout_height="48dp" android:contentDescription="@string/open_category_menu" app:icon="@drawable/ic_filter" app:iconGravity="textStart" app:iconPadding="0dp" app:iconTint="@color/ink"/>
    <com.google.android.material.button.MaterialButton android:id="@+id/notifications" style="@style/Widget.MaterialComponents.Button.TextButton.Icon" android:layout_width="48dp" android:layout_height="48dp" android:contentDescription="Thông báo" app:icon="@drawable/ic_notifications" app:iconGravity="textStart" app:iconPadding="0dp" app:iconTint="@color/ink"/>
    <com.google.android.material.button.MaterialButton android:id="@+id/shop" style="@style/Widget.MaterialComponents.Button.TextButton.Icon" android:layout_width="48dp" android:layout_height="48dp" android:contentDescription="@string/search_hint" app:icon="@drawable/ic_search" app:iconGravity="textStart" app:iconPadding="0dp" app:iconTint="@color/ink"/>
  </LinearLayout>
  <com.google.android.material.card.MaterialCardView android:id="@+id/category_panel" style="@style/Card.Lauriel" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/space_12" android:visibility="gone" app:cardBackgroundColor="@color/surface">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/space_12">
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/product_categories" android:textAppearance="@style/TextAppearance.Lauriel.SectionTitle"/>
      <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_sm" android:fillViewport="true" android:scrollbars="none">
        <com.google.android.material.chip.ChipGroup android:id="@+id/category_list" android:layout_width="wrap_content" android:layout_height="wrap_content" app:chipSpacingHorizontal="@dimen/space_sm" app:singleLine="true" app:singleSelection="true" app:selectionRequired="true"/>
      </HorizontalScrollView>
    </LinearLayout>
  </com.google.android.material.card.MaterialCardView>
  <TextView android:id="@+id/promotion_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_xxs" android:text="@string/active_promotions" android:textAppearance="@style/TextAppearance.Lauriel.SectionTitle"/>
  <TextView android:id="@+id/promotion_hint" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_xxs" android:text="@string/promotion_swipe_hint" android:textAppearance="@style/TextAppearance.Lauriel.Caption"/>
  <androidx.recyclerview.widget.RecyclerView android:id="@+id/promotions" android:layout_width="match_parent" android:layout_height="208dp" android:layout_marginTop="@dimen/space_sm" android:clipToPadding="false" android:orientation="horizontal" android:overScrollMode="never" android:paddingEnd="36dp" android:scrollbars="none"/>
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_md" android:gravity="center_vertical"><TextView android:id="@+id/product_section_title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/featured_products" android:textAppearance="@style/TextAppearance.Lauriel.SectionTitle"/><com.google.android.material.button.MaterialButton android:id="@+id/load_more" style="@style/TextButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/see_all"/></LinearLayout>
  <com.google.android.material.progressindicator.CircularProgressIndicator android:id="@+id/loading" android:layout_width="32dp" android:layout_height="32dp" android:layout_gravity="center" android:visibility="gone" app:indicatorColor="@color/ink" app:trackThickness="3dp"/>
  <ImageView android:id="@+id/state_icon" android:contentDescription="@null" android:layout_width="48dp" android:layout_height="48dp" android:layout_gravity="center" android:layout_marginTop="@dimen/space_md" android:src="@drawable/ic_empty_bag" android:visibility="gone"/>
  <TextView android:id="@+id/error" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:textColor="@color/danger" android:textSize="14sp"/>
  <TextView android:id="@+id/empty" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="@string/empty_products" android:textAppearance="@style/TextAppearance.Lauriel.Body" android:visibility="gone"/>
  <androidx.recyclerview.widget.RecyclerView android:id="@+id/list" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:clipToPadding="false" android:paddingBottom="@dimen/space_md"/>
</LinearLayout>
